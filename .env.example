# ============================================================
# PostgREST + PostgreSQL (Hugging Face Space) — env vars
# Copy to `.env` and adjust. HF Spaces only allows PORT to be
# set via the Space settings; everything else can live here.
# ============================================================

# --- Server ---
# Port PostgREST listens on. HF Spaces requires 7860.
PORT=7860
# Bind address (keep 0.0.0.0 for HF Spaces)
PGRST_SERVER_HOST=0.0.0.0

# --- Database connection ---
# Full connection URI. Inside this container Postgres runs on a
# local unix socket, so the default below is usually fine.
# For an external DB, use e.g.:
#   postgresql://authenticator:secret@db.example.com:5432/prod
PGRST_DB_URI=postgresql://?host=/var/run/postgresql&port=5432&dbname=postgres

# Comma-separated schemas exposed by the API
PGRST_DB_SCHEMA=api

# Role used for unauthenticated (anonymous) requests
PGRST_DB_ANON_ROLE=web_anon

# Role used to apply schema changes / own objects
AUTHENTICATOR_PASSWORD=secret

# --- Auth (optional) ---
# Secret used to sign/verify JWTs. Generate one with:
#   echo "secret" | openssl dgst -sha256 -hmac "your-key" -binary | base64
# Leave empty to disable JWT auth (public API).
PGRST_JWT_SECRET=
# Claim that carries the DB role in the JWT.
# Must be a JSON path — it MUST start with a dot (or be a bracket
# expression). "role" alone is a parse error and crashes PostgREST.
PGRST_JWT_ROLE_CLAIM_KEY=.role
# Audience claim to require, if any
PGRST_JWT_AUDIENCE=

# --- API behavior (optional) ---
# Max rows per request (Content-Range limiting)
PGRST_MAX_ROWS=
# Allow CORS from any origin (useful for browser clients)
PGRST_CORS_ALLOWED_ORIGINS=*
# Path prefix if served behind a proxy (usually empty on HF)
PGRST_SERVER_PATH_PREFIX=

# --- PostgREST version pinned in the Dockerfile ---
PGRST_VERSION=16.2